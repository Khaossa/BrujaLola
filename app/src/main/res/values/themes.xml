<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DivinationApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/deep_purple</item>
        <item name="colorPrimaryVariant">@color/deep_purple_dark</item>
        <item name="colorOnPrimary">@color/light_lavender</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorSecondaryVariant">@color/gold_accent</item> <!-- Can be same as colorSecondary or a bit darker gold -->
        <item name="colorOnSecondary">@color/deep_purple</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/deep_purple</item>
        <!-- Default text color -->
        <item name="android:textColor">@color/light_lavender</item>
        <!-- Default font families (using Android defaults for now) -->
        <item name="android:fontFamily">sans-serif</item> <!-- Default app font -->
        <item name="fontFamily">sans-serif</item> <!-- Default app font for Material Components -->

        <!-- Define text appearances for specific elements if needed -->
        <item name="textAppearanceHeadline6">@style/TextAppearance.App.Headline6</item>
        <item name="textAppearanceBody1">@style/TextAppearance.App.Body1</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>

    </style>

    <!-- Text Appearances -->
    <style name="TextAppearance.App.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/light_lavender</item>
    </style>

    <style name="TextAppearance.App.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/light_lavender</item>
    </style>

    <!-- Specific Widget Styles -->
    <style name="Widget.App.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/light_lavender</item>
        <item name="cardCornerRadius">8dp</item>
        <!-- Add other card attributes if necessary -->
    </style>

    <!-- DatePicker Style -->
    <style name="DatePickerStyle" parent="android:Widget.Material.Light.DatePicker">
        <item name="android:headerBackground">?attr/colorPrimaryVariant</item>
        <item name="android:calendarTextColor">?attr/colorOnPrimary</item>
        <item name="android:dayOfWeekBackground">?attr/colorPrimary</item>
        <item name="android:dayOfWeekTextAppearance">@style/TextAppearance.App.Body1</item> <!-- Use custom text appearance -->
        <item name="android:yearListSelectorColor">?attr/colorSecondary</item>
        <item name="android:datePickerMode">spinner</item>
        <item name="android:textColorPrimary">?attr/colorOnPrimary</item> <!-- Text color for date numbers -->
        <item name="android:colorControlNormal">?attr/colorOnPrimary</item> <!-- Color for spinners -->
    </style>

</resources>
